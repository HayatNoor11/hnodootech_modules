<?xml version="1.0"?>

<odoo>
   <data>
        <record model="ir.ui.view" id="hn_top_sale_item_report_view">
           <field name="name">hn.top_sale_report.form</field>
           <field name="model">hn.topsaleitem.report</field>
           <field name="arch" type="xml">
               <form string="Hn Topsale Items Report">
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="top_sale_value"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                   </group>
                   <footer>
                       <button string="Print" name="top_sale_item" type="object" class="oe_highlight"/> or 
                       <button string="Cancel" name ="cancel" special="cancel"/>
                   </footer>
               </form>
           </field>
       </record>

        <record id="hn_top_sale_item_report_action" model="ir.actions.act_window">
            <field name="name">Hn Top Selling Products</field>
            <field name="res_model">hn.topsaleitem.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
        </record> 
       
   </data>
</odoo>
